#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>

101 DIALOGEX 0, 0, 436, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CC Switch Usage 选项"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "统计周期", -1, 12, 15, 50, 12
    COMBOBOX 1001, 66, 12, 138, 62, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "费用币种", -1, 12, 39, 50, 12
    COMBOBOX 1002, 66, 36, 138, 62, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "实付单价", -1, 12, 63, 50, 12
    EDITTEXT 1003, 66, 60, 60, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "元 / 1 USD 用量", -1, 132, 63, 90, 12
    LTEXT "留空使用 CC Switch 汇率", -1, 66, 81, 140, 12
    LTEXT "各列未勾选时统计全部供应商", -1, 12, 96, 350, 12
    LTEXT "Token 供应商", -1, 12, 112, 115, 12
    PUSHBUTTON "全选", 1006, 142, 109, 34, 15
    PUSHBUTTON "反选", 1007, 180, 109, 34, 15
    CONTROL "", 1004, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 12, 127, 202, 97
    LTEXT "费用供应商", -1, 222, 112, 115, 12
    PUSHBUTTON "全选", 1008, 352, 109, 34, 15
    PUSHBUTTON "反选", 1009, 390, 109, 34, 15
    CONTROL "", 1005, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 222, 127, 202, 97
    DEFPUSHBUTTON "确定", IDOK, 316, 236, 51, 14
    PUSHBUTTON "取消", IDCANCEL, 373, 236, 51, 14
END
